{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sap-agent-workbench:m2:abap-development-result:v1",
  "title": "M2 SAP ABAP Development Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "provenance",
    "status",
    "architecture_alignment",
    "unknowns",
    "existing_objects_used",
    "proposed_new_objects",
    "implementation_plan",
    "work_products",
    "assumptions",
    "risks",
    "required_verification",
    "verification_claims",
    "review_handoff",
    "requested_capabilities",
    "next_action"
  ],
  "properties": {
    "contract_version": {
      "const": "m2.abap-development-result.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_fingerprint",
        "configuration_fingerprint",
        "architecture_handoff_fingerprint"
      ],
      "properties": {
        "input_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "configuration_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "architecture_handoff_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "WORK_PRODUCT_READY",
        "NEEDS_CLARIFICATION",
        "BLOCKED"
      ]
    },
    "architecture_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "constraint_results"
      ],
      "properties": {
        "status": {
          "enum": [
            "PRESERVED",
            "REQUIRES_REVIEW"
          ]
        },
        "constraint_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "constraint_ref",
              "status",
              "notes"
            ],
            "properties": {
              "constraint_ref": {
                "type": "string",
                "pattern": "^AC-[0-9]{3,}$"
              },
              "status": {
                "enum": [
                  "PRESERVED",
                  "REQUIRES_REVIEW"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "material",
          "blocks_work_product",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^U-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "blocks_work_product": {
            "type": "boolean"
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "existing_objects_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref",
          "purpose"
        ],
        "properties": {
          "object_ref": {
            "type": "string",
            "pattern": "^OBJ-[0-9]{3,}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proposed_new_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposed_name",
          "kind",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NEW-[0-9]{3,}$"
          },
          "proposed_name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "CLASS",
              "INTERFACE",
              "TABLE",
              "STRUCTURE",
              "FUNCTION_MODULE",
              "BADI_IMPLEMENTATION",
              "ENHANCEMENT",
              "CDS",
              "RAP_OBJECT",
              "ODATA_SERVICE",
              "FORM",
              "OTHER"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "implementation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "object_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PLAN-[0-9]{3,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "object_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(OBJ|NEW)-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "work_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "target_object_ref",
          "language",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WP-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "ABAP_SOURCE",
              "PATCH",
              "PSEUDOCODE",
              "DDIC_DESIGN",
              "TEST_SEAM",
              "IMPLEMENTATION_NOTE",
              "OTHER"
            ]
          },
          "target_object_ref": {
            "type": "string",
            "pattern": "^(OBJ|NEW)-[0-9]{3,}$"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "description",
          "mitigation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "CORRECTNESS",
              "PERFORMANCE",
              "SECURITY",
              "AUTHORIZATION",
              "TRANSACTIONALITY",
              "UPGRADE",
              "INTEGRATION",
              "MAINTAINABILITY",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "description",
          "blocking_for_delivery"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "COMPILE",
              "ATC",
              "UNIT_TEST",
              "INTEGRATION_TEST",
              "AUTHORIZATION",
              "PERFORMANCE",
              "PAYLOAD_CONTRACT",
              "RUNTIME",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking_for_delivery": {
            "type": "boolean"
          }
        }
      }
    },
    "verification_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "type": {
            "enum": [
              "COMPILE",
              "ATC",
              "UNIT_TEST",
              "INTEGRATION_TEST",
              "AUTHORIZATION",
              "PERFORMANCE",
              "PAYLOAD_CONTRACT",
              "RUNTIME",
              "OTHER"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "review_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_for_review",
        "notes"
      ],
      "properties": {
        "ready_for_review": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verb",
          "purpose"
        ],
        "properties": {
          "verb": {
            "enum": [
              "READ",
              "QUERY",
              "ANALYZE",
              "PROPOSE"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "REQUEST_CLARIFICATION",
            "VERIFY_IMPLEMENTATION_CONTEXT",
            "RETURN_TO_ARCHITECTURE",
            "HANDOFF_REVIEW",
            "NONE"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
