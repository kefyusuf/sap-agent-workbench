{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sap-agent-workbench:m3:sap-review-input:v1",
  "title": "M3 SAP Reviewer Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task",
    "scope",
    "architecture_handoff",
    "requirements",
    "implementation_snapshot",
    "evidence_catalog",
    "review_rules",
    "capability_boundary",
    "resolved_configuration_fingerprint",
    "requested_result_contract"
  ],
  "properties": {
    "contract_version": {
      "const": "m3.sap-review-input.v1"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "review_objective",
        "requested_outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "review_objective": {
          "type": "string",
          "minLength": 1
        },
        "requested_outcome": {
          "const": "IMPLEMENTATION_REVIEW"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "systems",
        "environments",
        "project"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "architecture_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "approach",
        "constraints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AH-[0-9]{3,}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "approach": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "material"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AC-[0-9]{3,}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "material": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "material",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "implementation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "status",
        "existing_object_refs",
        "proposed_object_refs",
        "work_products",
        "required_verification",
        "verification_claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^IMP-[0-9]{3,}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "WORK_PRODUCT_READY",
            "NEEDS_CLARIFICATION",
            "BLOCKED"
          ]
        },
        "existing_object_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OBJ-[0-9]{3,}$"
          }
        },
        "proposed_object_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NEW-[0-9]{3,}$"
          }
        },
        "work_products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "summary",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^WP-[0-9]{3,}$"
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "required_verification": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "COMPILE",
              "ATC",
              "UNIT_TEST",
              "INTEGRATION_TEST",
              "AUTHORIZATION",
              "PERFORMANCE",
              "PAYLOAD_CONTRACT",
              "RUNTIME",
              "OTHER"
            ]
          }
        },
        "verification_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "type": {
                "enum": [
                  "COMPILE",
                  "ATC",
                  "UNIT_TEST",
                  "INTEGRATION_TEST",
                  "AUTHORIZATION",
                  "PERFORMANCE",
                  "PAYLOAD_CONTRACT",
                  "RUNTIME",
                  "REGRESSION"
                ]
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^E-[0-9]{3,}$"
                }
              }
            }
          }
        }
      }
    },
    "evidence_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "source_ref",
          "revision",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "LIVE_SYSTEM",
              "SOURCE_CODE",
              "EXECUTION_RESULT",
              "TEST_RESULT",
              "STATIC_ANALYSIS",
              "LOG",
              "CONFIGURATION",
              "APPROVED_DOCUMENT",
              "DECISION_RECORD",
              "OFFICIAL_DOCUMENTATION",
              "USER_CONFIRMATION"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "statement",
          "material",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RR-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "ARCHITECTURE",
              "CORRECTNESS",
              "PERFORMANCE",
              "SECURITY",
              "AUTHORIZATION",
              "TRANSACTIONALITY",
              "MAINTAINABILITY",
              "OBSERVABILITY",
              "VERIFICATION",
              "UPGRADE",
              "OTHER"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "capability_boundary": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ",
          "QUERY",
          "ANALYZE",
          "PROPOSE"
        ]
      }
    },
    "resolved_configuration_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requested_result_contract": {
      "const": "m3.sap-review-result.v1"
    }
  }
}
