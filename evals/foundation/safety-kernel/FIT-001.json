  },
  "when": {
    "path": "agent-direct-to-tool"
  },
  "then": {
    "result": "FAIL",
    "direct_execution_allowed": false,
    "required_path": [
      "ActionIntent",
      "Orchestrator",
      "CapabilityResolver",
      "PolicyEngine",
      "ToolRuntime"
    ]
  },
  "invariant": "An Agent has no unrestricted direct privilege path to a Tool.",
  "decision_refs": ["SAP-AW-D016", "SAP-AW-D017"]
